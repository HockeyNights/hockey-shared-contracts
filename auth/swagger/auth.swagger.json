  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1Account": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "emailVerified": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1CodePurpose": {
      "type": "string",
      "enum": [
        "CODE_PURPOSE_UNSPECIFIED",
        "CODE_PURPOSE_REGISTRATION",
        "CODE_PURPOSE_LOGIN",
        "CODE_PURPOSE_PASSWORD_RESET"
      ],
      "default": "CODE_PURPOSE_UNSPECIFIED"
    },
    "v1CodeSent": {
      "type": "object",
      "properties": {
        "maskedEmail": {
          "type": "string"
        },
        "expiresIn": {
          "type": "string",
          "format": "int64",
          "description": "Сколько секунд действует код."
        },
        "resendAfter": {
          "type": "string",
          "format": "int64",
          "description": "Через сколько секунд можно запросить код заново."
        }
      }
    },
    "v1GetMeResponse": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/definitions/v1Account"
        }
      }
    },
    "v1LoginRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "deviceToken": {
          "type": "string"
        },
        "deviceName": {
          "type": "string"
        }
      }
    },
    "v1LoginResponse": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/definitions/v1CodeSent"
        },
        "account": {
          "$ref": "#/definitions/v1Account"
        },
        "tokens": {
          "$ref": "#/definitions/v1TokenPair"
        },
        "codeRequired": {
          "type": "boolean"
        }
      }
    },
    "v1LogoutAllRequest": {
      "type": "object"
    },
    "v1LogoutAllResponse": {
      "type": "object"
    },
    "v1LogoutRequest": {
      "type": "object",
      "title": "сессия определяется по access-токену вызывающего"
    },
    "v1LogoutResponse": {
      "type": "object"
    },
    "v1RefreshRequest": {
      "type": "object",
      "properties": {
        "refreshToken": {
          "type": "string"
        }
      }
    },
    "v1RefreshResponse": {
      "type": "object",
      "properties": {
        "tokens": {
          "$ref": "#/definitions/v1TokenPair"
        }
      }
    },
    "v1RegisterRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "v1RegisterResponse": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/definitions/v1CodeSent"
        }
      }
    },
    "v1RequestPasswordResetRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        }
      }
    },
    "v1RequestPasswordResetResponse": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/definitions/v1CodeSent"
        }
      }
    },
    "v1ResendCodeRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "purpose": {
          "$ref": "#/definitions/v1CodePurpose"
        }
      }
    },
    "v1ResendCodeResponse": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/definitions/v1CodeSent"
        }
      }
    },
    "v1ResetPasswordRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "newPassword": {
          "type": "string",
          "description": "Те же границы, что и при регистрации. Верхняя не косметическая:\nbcrypt-совместимые реализации молча режут вход на 72 байтах, и хотя\nздесь argon2id, единое ограничение избавляет от расхождения, если\nалгоритм когда-нибудь сменится."
        }
      }
    },
    "v1ResetPasswordResponse": {
      "type": "object",
      "description": "Токенов в ответе нет намеренно: смена пароля завершает все сессии, в том\nчисле ту, из которой её запросили. Клиент отправляет пользователя на\nобычный вход — так он сразу убеждается, что новый пароль работает."
    },
    "v1TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "type": "string"
        },
        "expiresIn": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1VerifyEmailRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "deviceName": {
          "type": "string"
        }
      }
    },
    "v1VerifyEmailResponse": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/definitions/v1Account"
        },
        "tokens": {
          "$ref": "#/definitions/v1TokenPair"
        },
        "deviceToken": {
          "type": "string"
        }
      }
    },
    "v1VerifyLoginCodeRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "deviceName": {
          "type": "string"
        }
      }
    },
    "v1VerifyLoginCodeResponse": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/definitions/v1Account"
        },
        "tokens": {
          "$ref": "#/definitions/v1TokenPair"
        },
        "deviceToken": {
          "type": "string"
        }
      }
    }
  },
  "securityDefinitions": {
    "bearer": {
      "type": "apiKey",
      "description": "Access-токен в формате: Bearer \u003ctoken\u003e",
      "name": "Authorization",
      "in": "header"
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
